{
  "name": "sagechi-production",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/prepare-sites.mjs",
    "typecheck": "tsc -b --pretty false",
    "analyze:worldtchi": "node scripts/analyze-glb.mjs public/models/worldtchi.glb",
    "analyze:sage-clips": "node scripts/analyze-animation-clips.mjs public/models/sages/fraux.glb --compact",
    "prepare:sages": "node scripts/prepare-sage-animations.mjs",
    "verify:sages": "node scripts/verify-sage-assets.mjs",
    "verify:animation": "node scripts/verify-animation-crossfade.mjs",
    "verify:phase6": "node --experimental-strip-types scripts/verify-phase6.mjs",
    "verify:phase8": "node --experimental-strip-types scripts/verify-phase8.mjs",
    "verify": "npm run typecheck && npm run build && npm run analyze:worldtchi && npm run verify:sages && npm run verify:animation && npm run verify:phase6 && npm run verify:phase8"
  },
  "dependencies": { "three": "^0.180.0" },
  "devDependencies": { "@openai/sites-vite-plugin": "0.2.0", "@types/three": "^0.180.0", "typescript": "^5.9.2", "vite": "^8.0.0" }
}
